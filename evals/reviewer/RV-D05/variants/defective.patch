+import { readdir, readFile, stat, realpath, unlink } from "node:fs/promises";
+import { join, resolve, relative, isAbsolute, sep } from "node:path";
+import type { Artifact, Removal } from "./model.ts";
 import { containedFile } from "./paths.ts";
 
 export async function listArtifacts(root: string): Promise<Artifact[]> {
@@ -14,3 +14,14 @@ export async function listArtifacts(root: string): Promise<Artifact[]> {
 export async function readArtifact(root: string, requested: string): Promise<string> {
     return readFile(await containedFile(root, requested), "utf8");
 }
+export async function removeArtifact(root: string, requested: string): Promise<Removal> {
+    const base = await realpath(root);
+    const target = await realpath(resolve(base, requested));
+    const path = relative(base, target);
+    if (target === base || !target.startsWith(base)) {
+        throw new Error("Artifact must be beneath the archive root");
+    }
+    if (!(await stat(target)).isFile()) throw new Error("Artifact must be a regular file");
+    await unlink(target);
+    return { removed: path };
+}
