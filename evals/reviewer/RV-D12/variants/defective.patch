+await check("a busy registry refuses registration without adding an entry", async () => {
+    const root = await mkdtemp(join(tmpdir(), "registry-"));
+    try {
+        await withRegistryLock(root, async () => {
+            await assert.rejects(() => registerProject(root, "atlas", catalog), /Registry busy/);
+        });
