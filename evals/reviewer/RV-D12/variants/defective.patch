-export async function registerProject(root: string, id: string, catalog: CatalogPort) {
+export interface RegistrationDependencies {
+    putEntry?: typeof putEntry;
+    withRegistryLock?: typeof withRegistryLock;
+}
+export async function registerProject(root: string, id: string, catalog: CatalogPort, deps?: RegistrationDependencies) {
     const entry = await requireCatalogEntry(catalog, id);
     validateEntry(entry);
