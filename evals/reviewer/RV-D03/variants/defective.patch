diff --git a/src/export.ts b/src/export.ts
index 24a2153..240d2e7 100644
--- a/src/export.ts
+++ b/src/export.ts
@@ -1,7 +1,19 @@
 import { fetchAccessions } from "./api.ts";
 import { formatAccessions } from "./format.ts";
+import type { Accession } from "./model.ts";

 export async function exportAccessions(endpoint: string): Promise<string> {
-    const page = await fetchAccessions(endpoint);
-    return formatAccessions(page.items);
+    const items: Accession[] = [];
+    const visited = new Set<string>();
+    let cursor: string | undefined;
+    for (;;) {
+        const page = await fetchAccessions(endpoint, cursor);
+        items.push(...page.items);
+        if (page.items.length === 0) break;
+        if (page.nextCursor === undefined) break;
+        if (visited.has(page.nextCursor)) throw new Error("Accession API repeated a cursor");
+        visited.add(page.nextCursor);
+        cursor = page.nextCursor;
+    }
+    return formatAccessions(items);
 }
