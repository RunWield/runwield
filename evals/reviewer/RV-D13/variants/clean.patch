+import type { ListOptions } from "./model.ts";
 import { listPlans } from "./store.ts";
+import { archivePlan } from "./archive.ts";
 
-export async function runCommand(root: string, args: string[]): Promise<string> {
-    if (args.length === 1 && args[0] === "list") return JSON.stringify(await listPlans(root));
-    throw new Error("Use list");
+export function parseListOptions(args: string[]): ListOptions {
+    if (args.some((arg) => arg !== "--archived-only")) throw new Error("Unsupported list option");
+    return { archivedOnly: args.includes("--archived-only") };
 }
+export async function runCommand(root: string, args: string[], now: () => Date = () => new Date()): Promise<string> {
+    if (args[0] === "archive" && args.length === 2) {
+        return JSON.stringify(await archivePlan(root, args[1], now()));
+    }
+    if (args[0] === "list") {
+        const options = parseListOptions(args.slice(1));
+        const records = await listPlans(root, options.archivedOnly ? "archived" : undefined);
+        return JSON.stringify(records);
+    }
+    throw new Error("Use archive <id> or list [--archived-only]");
+}
