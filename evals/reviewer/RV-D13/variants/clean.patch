+import { mkdir, rename } from "node:fs/promises";
+import { join } from "node:path";
+import { planFile, readPlan, savePlan } from "./store.ts";
+
+export async function archivePlan(root: string, id: string, time: Date) {
+    const record = await readPlan(root, "active", id);
+    const archived = { ...record, archivedAt: time.toISOString() };
+    await mkdir(join(root, "plans", "archived"), { recursive: true });
+    try {
+        await readPlan(root, "archived", id);
+        throw new Error("Plan already archived");
+    } catch (error) {
+        if (!(error instanceof Error && "code" in error && error.code === "ENOENT")) throw error;
+    }
+    await savePlan(root, "active", archived);
+    await rename(planFile(root, "active", id), planFile(root, "archived", id));
+    return archived;
+}
