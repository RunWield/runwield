 export class Command {
     private child;
+    private cancelled = false;
+    private settlement?: Promise<void>;
     readonly result: Promise<CommandResult>;

     get pid(): number | undefined {
@@ -20,7 +22,48 @@ export class Command {
                 output += chunk.toString();
             });
             this.child.once("error", reject);
-            this.child.once("close", (code) => resolve({ status: code === 0 ? "passed" : "failed", code, output }));
+            this.child.once("close", (code) => {
+                const result: CommandResult = { status: this.cancelled ? "cancelled" : code === 0 ? "passed" : "failed", code, output };
+                if (this.settlement) this.settlement.then(() => resolve(result), reject);
+                else resolve(result);
+            });
         });
     }
+
+    async cancel(): Promise<CommandResult> {
+        const pid = this.child.pid;
+        if (pid === undefined) return this.result;
+        try {
+            process.kill(-pid, 0);
+        } catch (error) {
+            if ((error as NodeJS.ErrnoException).code === "ESRCH") return this.result;
+            if ((error as NodeJS.ErrnoException).code !== "EPERM") throw error;
+        }
+        try {
+            process.kill(-pid, "SIGKILL");
+            this.cancelled = true;
+        } catch (error) {
+            if (!["ESRCH", "EPERM"].includes((error as NodeJS.ErrnoException).code ?? "")) throw error;
+        }
+        if (this.cancelled) {
+            this.settlement ??= this.waitForGroup(pid);
+            // Observe failures even if the process has not emitted close yet.
+            void this.settlement.catch(() => {});
+        }
+        return this.result;
+    }
+
+    private async waitForGroup(pid: number): Promise<void> {
+        const deadline = Date.now() + 10000;
+        while (true) {
+            try {
+                process.kill(-pid, 0);
+            } catch (error) {
+                if ((error as NodeJS.ErrnoException).code === "ESRCH") break;
+                if ((error as NodeJS.ErrnoException).code !== "EPERM") throw error;
+            }
+            if (Date.now() > deadline) throw new Error("Validation process group did not settle");
+            await new Promise((resolve) => setTimeout(resolve, 5));
+        }
+    }
 }
