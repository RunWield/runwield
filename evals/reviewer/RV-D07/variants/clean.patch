+const finished = startValidation(process.execPath, ["-e", "process.exit(0)"]);
+await finished.result;
+assert.equal((await within(finished.cancel())).status, "passed");
+console.log("PASS cancellation retains a finished result");
+
+// Keep the real subprocess, but control the OS group-probe boundary after SIGKILL.
+// A probe handshake makes this independent of process scheduling or kill latency.
+for (const failSettlement of [false, true]) {
+    const root = await mkdtemp(join(tmpdir(), "rv-d07-settlement-"));
+    const spawn = childProcess.spawn;
+    let closed!: Promise<void>;
+    childProcess.spawn = (...args: Parameters<typeof spawn>) => {
+        const child = spawn(...args);
+        closed = new Promise((resolve) => child.once("close", () => resolve()));
+        return child;
+    };
+    syncBuiltinESMExports();
+    const run = startValidation(process.execPath, [
+        fileURLToPath(new URL("./workload.ts", import.meta.url)), "direct", root,
+    ]);
+    childProcess.spawn = spawn;
+    syncBuiltinESMExports();
+    const kill = process.kill;
+    let killed = false;
+    let probes = 0;
+    let released = false;
+    let observed = false;
+    const publicResult = run.result.then(
+        (result) => { observed = true; return result; },
+        (error: Error) => { observed = true; throw error; },
+    );
+    void publicResult.catch(() => {});
+    try {
+        await ready(join(root, "ready"));
+        process.kill = (pid, signal) => {
+            if (pid === -run.pid! && signal === "SIGKILL") {
+                const sent = kill(pid, signal);
+                killed = true;
+                return sent;
+            }
+            if (pid === -run.pid! && signal === 0 && killed) {
+                probes++;
+                if (!released) return true;
+                if (failSettlement) throw new Error("Group probe failed");
+                throw Object.assign(new Error("Gone"), { code: "ESRCH" });
+            }
+            return kill(pid, signal);
+        };
+        const cancellation = run.cancel();
