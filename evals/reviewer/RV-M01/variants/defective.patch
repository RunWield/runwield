diff --git a/src/pagination.ts b/src/pagination.ts
--- a/src/pagination.ts
+++ b/src/pagination.ts
@@ -1,5 +1,17 @@
 import type { Project, ProjectCatalog } from "./model.ts";
 
 export async function collectProjects(catalog: ProjectCatalog): Promise<Project[]> {
-    return (await catalog.page()).items;
+    const projects: Project[] = [];
+    const visited = new Set<string>();
+    let cursor: string | undefined;
+    while (true) {
+        const page = await catalog.page(cursor);
+        projects.push(...page.items);
+        if (!page.items.length) break;
+        if (page.nextCursor === undefined) break;
+        if (visited.has(page.nextCursor)) throw new Error("Catalog repeated cursor");
+        visited.add(page.nextCursor);
+        cursor = page.nextCursor;
+    }
+    return projects;
 }
