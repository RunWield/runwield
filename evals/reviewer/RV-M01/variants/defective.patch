+await check("listing collects ordinary continuation pages in order", async () => {
+    const catalog: ProjectCatalog = {
+        page: async (cursor) => {
+            if (cursor === undefined) return { items: [{ id: "one", archived: false }], nextCursor: "two" };
+            assert.equal(cursor, "two", "Continuation must use the returned cursor");
+            return { items: [{ id: "two", archived: false }] };
+        },
+    };
+    assert.deepEqual(await listProjects(catalog, { filterEnabled: true }), [
+        { id: "one", archived: false },
+        { id: "two", archived: false },
+    ]);
+});
+await check("listing refuses a repeated continuation cursor", async () => {
+    const catalog: ProjectCatalog = {
+        page: async () => ({
+            items: [{ id: "one", archived: false }],
+            nextCursor: "again",
+        }),
+    };
+    await assert.rejects(() => listProjects(catalog), /Catalog repeated cursor/);
+});
 
