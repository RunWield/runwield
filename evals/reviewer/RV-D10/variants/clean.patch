@@ -1,4 +1,4 @@
-import { saveAttempt } from "./attempts.ts";
+import { readAttempt, saveAttempt } from "./attempts.ts";
 import { git, gitResult } from "./git.ts";
 import type { PublicationAttempt, PublicationRequest } from "./model.ts";
 
@@ -50,3 +50,17 @@ export async function publishValidated(
         error: null,
     });
 }
+
+export async function retryPublication(workspace: string, path: string): Promise<PublicationAttempt> {
+    const saved = await readAttempt(path);
+    if (saved.status === "published") return saved;
+    const target = fetchTarget(workspace, saved.remote, saved.targetRef);
+    const preparedCommit = prepare(workspace, saved.preparedCommit, target);
+    git(workspace, ["merge-base", "--is-ancestor", saved.candidate, preparedCommit]);
+    return send(workspace, path, {
+        ...saved,
+        preparedCommit,
+        expectedTarget: target,
+        status: "pending",
+    });
+}
