+
+export async function retryPublication(workspace: string, path: string): Promise<PublicationAttempt> {
+    const saved = await readAttempt(path);
+    if (saved.status === "published") return saved;
+    const target = fetchTarget(workspace, saved.remote, saved.targetRef);
+    const preparedCommit = saved.preparedCommit;
+    return send(workspace, path, {
+        ...saved,
+        preparedCommit,
+        expectedTarget: target,
+        status: "pending",
+    });
+}
