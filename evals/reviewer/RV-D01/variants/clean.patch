--- a/src/batch.ts
+++ b/src/batch.ts
@@ -2,9 +2,18 @@ import { readProjects, saveProjects } from "./catalog.ts";
 import { buildDigest } from "./digest.ts";
 import type { BatchResult } from "./model.ts";

-export async function refreshDigests(root: string): Promise<BatchResult> {
+export async function refreshDigests(root: string, selection?: string[]): Promise<BatchResult> {
     const projects = await readProjects(root);
-    for (const project of projects) project.digest = buildDigest(project);
-    await saveProjects(root, projects);
-    return { updated: projects.map((project) => project.id) };
+    const selected = new Set(selection ?? projects.map((project) => project.id));
+    for (const id of selected) {
+        if (!projects.some((project) => project.id === id)) throw new Error(`Project not found: ${id}`);
+    }
+    const updated: string[] = [];
+    for (const project of projects) {
+        if (!selected.has(project.id)) continue;
+        project.digest = buildDigest(project);
+        updated.push(project.id);
+    }
+    if (updated.length) await saveProjects(root, projects);
+    return { updated };
 }
