diff --git a/src/service.ts b/src/service.ts
index e879184..e55b6fd 100644
--- a/src/service.ts
+++ b/src/service.ts
@@ -30,11 +30,23 @@ export class TaskService {
         return task;
     }
     async completeTask(taskId: string): Promise<void> {
+        const state = await this.store.read();
+        if (state.notifications.includes(taskId) || state.consumers.some((entry) => entry.taskId === taskId)) return;
         const task = await this.recordCompletion(taskId);
         await this.onCompletion(task);
+        if (task.kind === "repair") await this.validation.consume({ taskId }, "validation");
+    }
+    async recover(): Promise<void> {
+        const state = await this.store.read();
+        if (state.phase !== "repairing") return;
+        const task = state.tasks.find((entry) => entry.id === state.repairTaskId);
+        if (task?.completed) await this.validation.consume({ taskId: task.id }, "validation");
     }
     private async onCompletion(task: Task): Promise<void> {
-        if (task.kind === "repair") return;
+        if (task.kind === "repair") {
+            await this.validation.consume({ taskId: task.id }, "listener");
+            return;
+        }
         const state = await this.store.read();
         state.notifications.push(task.id);
         await this.store.write(state);
