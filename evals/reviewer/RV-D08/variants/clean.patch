+        const prior = (await this.store.read()).tasks.find((task) => task.id === taskId);
+        if (prior?.completed) return;
         const task = await this.recordCompletion(taskId);
         await this.onCompletion(task);
+        if (task.kind === "repair") await this.validation.consume({ taskId }, "validation");
+    }
+    async recover(): Promise<void> {
+        const state = await this.store.read();
+        if (state.phase !== "repairing") return;
+        const task = state.tasks.find((entry) => entry.id === state.repairTaskId);
+        if (task?.completed) await this.validation.consume({ taskId: task.id }, "validation");
