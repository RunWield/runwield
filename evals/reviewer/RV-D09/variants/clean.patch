diff --git a/src/lifecycle.ts b/src/lifecycle.ts
--- a/src/lifecycle.ts
+++ b/src/lifecycle.ts
@@ -1,6 +1,20 @@
-import { readPlan } from "./plans.ts";
+import { runCommand } from "./commands.ts";
+import type { TransitionCommand } from "./commands.ts";
+import { readPlan, writePlan, withStatus } from "./plans.ts";
 
 export async function planStatus(path: string): Promise<string> {
     const plan = await readPlan(path);
     return /^status: (.*)$/m.exec(plan.frontMatter)![1];
 }
+
+export async function startValidation(path: string, command: TransitionCommand): Promise<void> {
+    const previous = await readPlan(path);
+    await writePlan(path, withStatus(previous, "validating"));
+    try {
+        await runCommand(command);
+    } catch (error) {
+        const current = await readPlan(path);
+        await writePlan(path, { ...current, frontMatter: previous.frontMatter });
+        throw error;
+    }
+}
