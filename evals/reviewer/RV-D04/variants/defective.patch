diff --git a/src/browser.ts b/src/browser.ts
--- a/src/browser.ts
+++ b/src/browser.ts
@@ -3,8 +3,18 @@
 import { summarize } from "./summary.ts";
 
 export class SummaryBrowser {
+    private summaries = new Map<string, PlanSummary>();
     constructor(private readonly repository: PlanRepository) {}
     async load(ref: PlanRef): Promise<PlanSummary> {
-        return summarize(await this.repository.read(ref));
+        const key = ref.name;
+        const summaries = this.summaries;
+        const previous = summaries.get(key);
+        if (previous) return { ...previous };
+        const result = summarize(await this.repository.read(ref));
+        summaries.set(key, result);
+        return { ...result };
+    }
+    refresh(): void {
+        this.summaries = new Map();
     }
 }
