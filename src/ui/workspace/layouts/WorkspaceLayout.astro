---
import "../../design-system/fonts.css";
import { RunWieldThinkingDots } from "../../design-system/components/react/RunWieldPrimitives.tsx";
import { ClientRouter } from "astro:transitions";
import { WorkspaceMenu } from "../react/WorkspaceMenu.tsx";
import { UnifiedWorkspaceSearch } from "../react/UnifiedWorkspaceSearch.tsx";
import WorkspacePwaHead from "../components/WorkspacePwaHead.astro";
import WorkspaceConnection from "../components/WorkspaceConnection.astro";
import { PLAN_SEARCH_QUERY_PARAM, PLAN_UI_TOKEN_QUERY } from "../constants.ts";

const {
    title = "RunWield Workspace",
    selectedTab = "active",
    url = Astro.url.href,
    shell = "workspace",
    surfaceTitle = "",
    boardHeader = false,
} = Astro.props;
const currentUrl = url instanceof URL ? url : new URL(String(url));
const localShell = shell === "local";
const projectPath = currentUrl.pathname.match(/^\/projects\/[^/]+/)?.[0];

function linkWithToken(path: string) {
    const ownerRoute = currentUrl.pathname === "/projects" || currentUrl.pathname.startsWith("/projects/") ||
        currentUrl.pathname === "/devices" || currentUrl.pathname === "/pair";
    const token = ownerRoute ? "" : currentUrl.searchParams.get(PLAN_UI_TOKEN_QUERY) || "";
    const query = currentUrl.searchParams.get(PLAN_SEARCH_QUERY_PARAM) || "";
    const next = new URL(path, currentUrl);
    if (token) next.searchParams.set(PLAN_UI_TOKEN_QUERY, token);
    if (query) next.searchParams.set(PLAN_SEARCH_QUERY_PARAM, query);
    return `${next.pathname}${next.search}`;
}
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        {!localShell && <WorkspacePwaHead />}
        <link rel="icon" href="/brand/logo.svg" type="image/svg+xml" />
        <link rel="stylesheet" href="/tokens.css" />
        <link rel="stylesheet" href="/components.css" />
        <link rel="stylesheet" href="/workspace.css" />
        <link rel="stylesheet" href="/theme.css" />
        {!localShell && <ClientRouter />}
        {!localShell && (
            <script>
                import { navigate } from "astro:transitions/client";
                document.addEventListener("astro:before-preparation", (event) => {
                    const indicator = document.querySelector<HTMLElement>("[data-workspace-navigation-loading]");
                    if (!indicator) return;
                    indicator.hidden = false;
                    const load = event.loader;
                    event.loader = async () => {
                        try { await load(); }
                        finally { indicator.hidden = true; }
                    };
                });
                document.addEventListener("runwield:workspace-navigate", (event) => {
                    if (!(event instanceof CustomEvent)) return;
                    event.preventDefault();
                    void navigate(event.detail.href, { history: event.detail.history }).then(
                        () => event.detail.onComplete?.(),
                        (error) => event.detail.onComplete?.(error),
                    );
                });
            </script>
        )}
    </head>
    <body class="theme-runwield">
        {localShell ? (
            <div class="workspace-shell workspace-local-shell" data-selected-tab={selectedTab} data-astro-workspace-shell>
                <header class="workspace-local-header" data-board-header={boardHeader || undefined}>
                    <a class="brand" href={linkWithToken("/")} aria-label="RunWield Plans home">
                        <img class="brand-logo" src="/brand/logo.svg" alt="" aria-hidden="true" />
                        <span>RunWield Plans</span>
                    </a>
                    <slot name="header-tabs" />
                    <div class="tab-search-slot" data-plan-search-slot>
                        <slot name="toolbar" />
                    </div>
                </header>
                <main>
                    <slot />
                </main>
            </div>
        ) : (
            <div class="workspace-shell workspace-shell-with-sidebar" data-selected-tab={selectedTab} data-astro-workspace-shell>
                <aside class="workspace-sidebar" data-workspace-sidebar aria-label="Workspace navigation" transition:name="workspace-sidebar" transition:persist>
                    <div class="workspace-sidebar-brand">
                        <WorkspaceMenu client:only="react" />
                        <a href={linkWithToken("/")} aria-label="RunWield Workspace home">
                            <img src="/brand/logo.svg" alt="" aria-hidden="true" />
                            <span>RunWield</span>
                        </a>
                    </div>
                    <a class="workspace-sidebar-home" href="/">Dashboard</a>
                    <a class="workspace-sidebar-new" href={projectPath ? `${projectPath}/sessions/new` : "/projects"}>
                        <span class="workspace-sidebar-plus" aria-hidden="true">+</span><span>New Session</span>
                    </a>
                    <a class="workspace-sidebar-section-title" href="/projects">Projects</a>
                    <nav class="workspace-sidebar-project-list" aria-label="Projects and Sessions">
                        <p class="workspace-sidebar-empty"><RunWieldThinkingDots label="Loading Projects" /></p>
                    </nav>
                </aside>
                <div class="workspace-main-shell">
                    <header class:list={["workspace-main-header", surfaceTitle && "workspace-main-surface-header"]} data-board-header={boardHeader || undefined}>
                        <div class="workspace-main-header-left" data-workspace-main-header-left>
                            {Astro.slots.has("header-tabs") ? <slot name="header-tabs" /> : surfaceTitle ? (
                                <strong class="workspace-main-session-name" data-workspace-surface-title>{surfaceTitle}</strong>
                            ) : (
                                <a class="brand workspace-main-brand" href={linkWithToken("/")} aria-label="RunWield Workspace home">
                                    <img class="brand-logo" src="/brand/logo.svg" alt="" aria-hidden="true" />
                                    <span>RunWield Workspace</span>
                                </a>
                            )}
                        </div>
                        <div class="tab-search-slot" data-plan-search-slot>
                            <slot name="toolbar" />
                        </div>
                        <div class="workspace-main-header-action-row">
                            <div class="workspace-main-header-actions" data-workspace-header-actions>
                                <UnifiedWorkspaceSearch client:only="react" />
                            </div>
                        </div>
                    </header>
                    <main>
                        <slot />
                    </main>
                </div>
            </div>
        )}
        {!localShell && <div class="workspace-navigation-loading" data-workspace-navigation-loading hidden>
            <RunWieldThinkingDots label="Loading page" />
        </div>}
        {!localShell && <script is:inline type="module" src="/workspace-shell.js"></script>}
        {!localShell && <WorkspaceConnection />}
    </body>
</html>
