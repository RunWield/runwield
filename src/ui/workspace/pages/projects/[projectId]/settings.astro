---
import ProjectRootForm from "../../../islands/ProjectRootForm.tsx";
import ArchivedSessions from "../../../islands/ArchivedSessions.tsx";
import SettingsLayout from "../../../layouts/SettingsLayout.astro";
import { loadOwnerProjects } from "../../../server/astro-owner-data.js";

const archived = Astro.url.searchParams.get("tab") === "archived";
const projectId = Astro.params.projectId ?? "";
const project = (await loadOwnerProjects()).find((item: { projectId: string }) => item.projectId === projectId);
if (!project) Astro.response.status = 404;
---
<SettingsLayout title={project ? `${project.displayName} settings · RunWield Workspace` : "Project settings · RunWield Workspace"} active="projects" childTitle="Project settings">
    {project ? (
        <>
            <div class="workspace-settings-intro">
                <h1>{project.displayName}</h1>
                <p>{project.rootLabel} · {project.healthStatus}</p>
            </div>
            <nav class="tabs workspace-settings-tabs" aria-label="Project settings sections">
                <a class={!archived ? "active" : undefined} href="?tab=general" aria-current={!archived ? "page" : undefined}>General</a>
                <a class={archived ? "active" : undefined} href="?tab=archived" aria-current={archived ? "page" : undefined}>Archived Sessions</a>
            </nav>
            {archived ? <ArchivedSessions projectId={projectId} client:load /> : <>
            <section class="owner-card project-settings-card">
                <h2>Project root</h2>
                <ProjectRootForm projectId={project.projectId} client:load />
            </section>
            <section class="owner-card project-settings-card">
                <h2>Maintenance</h2>
                <div class="workspace-settings-actions">
                    <button type="button" class="secondary-action" data-project-action={project.projectId} data-action={project.lifecycle === "disabled" ? "enable" : "disable"}>{project.lifecycle === "disabled" ? "Enable" : "Disable"}</button>
                    <button type="button" class="secondary-action" data-project-action={project.projectId} data-action="rescan">Full Session rescan</button>
                    <button type="button" class="danger-action" data-project-action={project.projectId} data-action="remove">Remove</button>
                </div>
                <p class="muted" data-project-action-status role="status"></p>
                <pre class="project-diagnostics" data-project-diagnostics={project.projectId} hidden></pre>
            </section>
            </>}
            <script is:inline data-astro-rerun>
                function rwSettingsOwnerCookie(name){return document.cookie.split('; ').find(v=>v.startsWith(name+'='))?.split('=').slice(1).join('=')||'';}
                async function rwSettingsOwnerFetch(url,options={}){const headers=new Headers({'content-type':'application/json','x-runwield-csrf':decodeURIComponent(rwSettingsOwnerCookie('rw_owner_csrf'))});new Headers(options.headers).forEach((value,name)=>headers.set(name,value));return await fetch(url,{...options,headers});}
                function rwSettingsNavigate(href){const event=new CustomEvent('runwield:workspace-navigate',{cancelable:true,detail:{href,history:'replace'}});if(document.dispatchEvent(event))location.replace(href);}
                document.querySelectorAll('[data-project-action]').forEach((button) => {
                    if (button.dataset.workspaceBound === 'true') return;
                    button.dataset.workspaceBound = 'true';
                    const card = button.closest('.project-settings-card');
                    const status = card?.querySelector('[data-project-action-status]');
                    button.addEventListener('click', async () => {
                        if (button.disabled) return;
                        if (button.dataset.action === 'remove' && !confirm('Remove this Project from Workspace? Repository files are not deleted.')) return;
                        const buttons = card?.querySelectorAll('[data-project-action]') || [button];
                        buttons.forEach((control) => { control.disabled = true; });
                        if (status) {
                            const loading = document.createElement('span');
                            loading.className = 'rw-thinking-glyph';
                            loading.setAttribute('aria-hidden', 'true');
                            status.replaceChildren(loading, document.createTextNode(' Updating Project...'));
                        }
                        const diagnostics = card?.querySelector('[data-project-diagnostics]');
                        if (diagnostics) diagnostics.hidden = true;
                        try {
                            const response = await rwSettingsOwnerFetch('/api/owner/projects/' + encodeURIComponent(button.dataset.projectAction) + '/action', {
                                method: 'POST',
                                body: JSON.stringify({ action: button.dataset.action }),
                            });
                            const data = response.ok ? await response.json() : await response.json().catch(() => ({}));
                            if (!response.ok) {
                                if (status) status.textContent = data.error || 'Project action failed.';
                                return;
                            }
                            if (status) status.textContent = '';
                            if (button.dataset.action === 'rescan') {
                                if (diagnostics) {
                                    diagnostics.hidden = false;
                                    diagnostics.textContent = (data.diagnostics || []).length ? JSON.stringify(data.diagnostics, null, 2) : 'Full Session catalog rescan completed with no diagnostics.';
                                }
                                return;
                            }
                            rwSettingsNavigate(button.dataset.action === 'remove' ? '/projects' : location.pathname + location.search);
                        } catch {
                            if (status) status.textContent = 'Project action could not be confirmed. Check your connection and try again.';
                        } finally {
                            buttons.forEach((control) => { control.disabled = false; });
                        }
                    });
                });
            </script>
        </>
    ) : (
        <section class="error-panel">
            <h2>Project settings not found</h2>
            <p>The requested Project is not registered.</p>
        </section>
    )}
</SettingsLayout>
