---
import type { PlanReadAvailability } from "../../../../../../plan-store.js";
import LoadingSurface from "../../../../components/LoadingSurface.astro";
import WorkspaceLayout from "../../../../layouts/WorkspaceLayout.astro";
import ReviewLayout from "../../../../layouts/ReviewLayout.astro";
import { PlanDetail } from "../../../../components/PlanDetail.jsx";
import { PlanReviewSurface } from "../../../../react/PlanReviewSurface.tsx";
import { PlanHomeSurface } from "../../../../react/PlanHomeSurface.tsx";
import { serializeCanonicalPlanError } from "../../../../server/astro-canonical-data.js";
import {
    getAstroOwnerWorkspaceSessionContinuation,
    getAstroOwnerWorkspaceStore,
    loadOwnerProjectPlanDetail,
} from "../../../../server/astro-owner-data.js";

type WorkspacePlanAttrs = {
    status?: string;
    classification?: string;
    type?: string;
    parentPlan?: string;
};

type WorkspacePlanDetail = {
    readAvailability?: PlanReadAvailability;
    planName?: string;
    title?: string;
    status?: string;
    classification?: string;
    type?: string;
    parentPlan?: string;
    path?: string;
    markdown?: string;
    body?: string;
    attrs?: WorkspacePlanAttrs;
};

type CanonicalPlanError = { error: string; repair: string };

type WorkspaceSessionContinuation = {
    getLivePlanReview?: (options: {
        projectId: string;
        planId: string;
        runwieldSessionId: string;
        operationId: string;
        interactionId: string;
    }) => Promise<{
        request?: {
            planReview?: {
                sequenceDocuments?: Array<{ path?: string; title?: string; markdown?: string }>;
                previousPlan?: string;
                planVersions?: Array<{ label?: string; markdown?: string; createdAt?: string }>;
                classification?: string;
                agentLabel?: string;
            };
        };
    } | null>;
};

type OwnerWorkspaceStore = {
    inspectSessionActivation?: (runwieldSessionId: string) => {
        activation?: { state?: string };
        generation?: { generation?: number | null; currentSegmentId?: string | null };
    };
};

const projectId = Astro.params.projectId ?? "";
const planId = Astro.params.planId ?? "";
const documentName = planId === "document" ? Astro.url.searchParams.get("name") || undefined : undefined;
const requestedSessionId = Astro.url.searchParams.get("session") || "";
const operationId = Astro.url.searchParams.get("operation") || "";
const interactionId = Astro.url.searchParams.get("interaction") || "";
let liveReview: Awaited<ReturnType<NonNullable<WorkspaceSessionContinuation["getLivePlanReview"]>>> | null = null;
let plan: WorkspacePlanDetail | null = null;
let error: CanonicalPlanError | null = null;
let recoveryGeneration: number | null = null;
let recoveryCurrentSegmentId: string | null = null;
try {
    plan = await loadOwnerProjectPlanDetail(projectId, planId, { reviewOnly: Boolean(operationId && interactionId), documentName });
} catch (caught) {
    const serializedError = await serializeCanonicalPlanError(caught) as CanonicalPlanError;
    error = serializedError;
    Astro.response.status = serializedError.error.includes("not found") || serializedError.error.includes("Plan not found")
        ? 404
        : 409;
}
const store = getAstroOwnerWorkspaceStore() as OwnerWorkspaceStore | null;
const provenSessionId = requestedSessionId;
if (plan && provenSessionId && operationId && interactionId && !error) {
    try {
        const continuation = getAstroOwnerWorkspaceSessionContinuation() as WorkspaceSessionContinuation | null;
        liveReview = await continuation?.getLivePlanReview?.({
            projectId,
            planId,
            runwieldSessionId: provenSessionId,
            operationId,
            interactionId,
        }) || null;
        const inspected = getAstroOwnerWorkspaceStore()?.inspectSessionActivation?.(provenSessionId);
        recoveryGeneration = inspected?.generation?.generation ?? null;
        recoveryCurrentSegmentId = inspected?.generation?.currentSegmentId ?? null;
    } catch {
        liveReview = null;
    }
}
const fromDashboard = Astro.url.searchParams.get("from") === "dashboard";
let searchReturnHref = "";
try {
    const candidate = new URL(Astro.url.searchParams.get("return") || "", Astro.url.origin);
    if (candidate.origin === Astro.url.origin && candidate.pathname === "/search") {
        searchReturnHref = `${candidate.pathname}${candidate.search}`;
    }
} catch {
    searchReturnHref = "";
}
const sessionId = provenSessionId;
if (store && plan && sessionId && recoveryGeneration === null && !error) {
    try {
        const inspected = store.inspectSessionActivation?.(sessionId);
        recoveryGeneration = inspected?.generation?.generation ?? null;
        recoveryCurrentSegmentId = inspected?.generation?.currentSegmentId ?? null;
    } catch {
        recoveryGeneration = null;
        recoveryCurrentSegmentId = null;
    }
}
const sessionHref = sessionId
    ? `/projects/${encodeURIComponent(projectId)}/sessions/${encodeURIComponent(sessionId)}`
    : `/projects/${encodeURIComponent(projectId)}/sessions?plan=${encodeURIComponent(planId)}`;
const canRecover = false;
const planHomePayload = plan
    ? {
        mode: "workspace",
        planId,
        planName: plan.planName,
        title: plan.title || plan.planName || planId,
        status: plan.status || plan.attrs?.status,
        classification: plan.classification || plan.attrs?.classification,
        type: plan.type || plan.attrs?.type,
        parentPlan: plan.parentPlan || plan.attrs?.parentPlan,
        artifactPath: plan.path,
        markdown: plan.markdown || plan.body || "",
        returnHref: searchReturnHref || (fromDashboard ? "/" : `/projects/${encodeURIComponent(projectId)}/plans`),
        returnLabel: searchReturnHref ? "Back to Search" : fromDashboard ? "Back to Dashboard" : "Back to Plans",
        planHref: `/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}`,
        sessionHref,
        reviewHref: operationId && interactionId && sessionId
            ? `/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}?session=${encodeURIComponent(sessionId)}&operation=${encodeURIComponent(operationId)}&interaction=${encodeURIComponent(interactionId)}`
            : "",
        reviewKind: liveReview ? "plan" : "",
        interactionHref: operationId && interactionId && sessionId
            ? `${sessionHref}#interaction-${encodeURIComponent(interactionId)}`
            : "",
        progressApiUrl: documentName ? "" : `/api/owner/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}/progress${sessionId ? `?session=${encodeURIComponent(sessionId)}` : ""}`,
        continueUrl: "",
        planWorkflowUrl: sessionId
            ? `/api/owner/projects/${encodeURIComponent(projectId)}/sessions/${encodeURIComponent(sessionId)}/plan-workflow`
            : "",
        recoveryUrl: "",
        canRecover,
        expectedGeneration: recoveryGeneration,
        expectedCurrentSegmentId: recoveryCurrentSegmentId,
        workflow: {
            sessionState: "",
            degradedMessage: plan.readAvailability?.kind === "pending" ? plan.readAvailability.message || "Workflow details pending." : "",
            progressFacts: [],
        },
    }
    : null;
const reviewPayload = plan && liveReview
    ? {
        mode: "workspace",
        csrfToken: Astro.cookies.get("rw_owner_csrf")?.value || "",
        sequenceDocuments: liveReview.request?.planReview?.sequenceDocuments,
        plan: plan.markdown || plan.body || "",
        previousPlan: liveReview.request?.planReview?.previousPlan || undefined,
        planVersions: liveReview.request?.planReview?.planVersions || undefined,
        projectId,
        planPath: plan.path,
        classification: liveReview.request?.planReview?.classification,
        agentLabel: liveReview.request?.planReview?.agentLabel || "Planner",
        runwieldSessionId: sessionId,
        reviewContext: {
            projectLabel: projectId,
            sessionHref,
            sessionLabel: sessionId,
            actingSession: sessionId,
            planLabel: plan.title || plan.planName || planId,
            planStatus: plan.status || plan.attrs?.status,
            live: true,
        },
        interactionAnswerUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/session-operations/${
            encodeURIComponent(operationId)
        }/interactions/${encodeURIComponent(interactionId)}/answer`,
        interactionAnswerBaseUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/session-operations/${
            encodeURIComponent(operationId)
        }/interactions`,
        interactionId,
        operationStatusUrl: `/api/owner/session-operations/${encodeURIComponent(operationId)}`,
        planDetailUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}`,
        recoveryUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/sessions/${
            encodeURIComponent(sessionId)
        }/force-recovery`,
        recoveryExpectedGeneration: recoveryGeneration,
        recoveryExpectedCurrentSegmentId: recoveryCurrentSegmentId,
        progressUrl: `/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}?session=${
            encodeURIComponent(sessionId)
        }`,
    }
    : null;
const Layout = reviewPayload ? ReviewLayout : WorkspaceLayout;
---
<Layout
    title={plan ? `${plan.planName} · RunWield Workspace` : "Project Plan · RunWield Workspace"}
    surfaceTitle={planHomePayload?.title || ""}
    selectedTab="projects"
    url={Astro.url.href}
>
    {error ? (
        <section class="error-panel">
            <h2>Project Plan lookup failed</h2>
            <p>{error.error}</p>
            <p>{error.repair}</p>
        </section>
    ) : reviewPayload ? (
        <PlanReviewSurface payload={reviewPayload} client:only="react">
            <LoadingSurface slot="fallback" label="Loading Plan review" />
        </PlanReviewSurface>
    ) : planHomePayload ? (
        <PlanHomeSurface payload={planHomePayload} presentation="workspace" client:only="react">
            <LoadingSurface slot="fallback" label="Loading Plan" />
        </PlanHomeSurface>
    ) : (
        <PlanDetail
            plan={plan}
            url={Astro.url.href}
            editIntent={false}
            progress={null}
            projectId={projectId}
            runwieldSessionId={sessionId}
            client:load
        />
    )}
</Layout>
