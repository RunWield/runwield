---
import LoadingSurface from "../../../../../../components/LoadingSurface.astro";
import ReviewLayout from "../../../../../../layouts/ReviewLayout.astro";
import { CodeReviewSurface } from "../../../../../../react/CodeReviewSurface.tsx";
import type { CodeReviewOptions } from "../../../../../../react/review-types.ts";

import { getAstroOwnerWorkspaceSessionContinuation } from "../../../../../../server/astro-owner-data.ts";

type LiveCodeReviewReference = Pick<CodeReviewOptions, "rawPatch" | "planTitle" | "planName">;

const projectId = Astro.params.projectId ?? "";
const runwieldSessionId = Astro.params.runwieldSessionId ?? "";
const operationId = Astro.url.searchParams.get("operation") || "";
const interactionId = Astro.url.searchParams.get("interaction") || "";
const liveReview = operationId && interactionId
    ? await getAstroOwnerWorkspaceSessionContinuation()?.getLiveCodeReview?.({
        projectId,
        runwieldSessionId,
        operationId,
        interactionId,
    }) || null
    : null;

if (!liveReview) Astro.response.status = 404;
const codeReview = (liveReview?.request?.codeReview as LiveCodeReviewReference | undefined) || null;
const sessionHref = `/projects/${encodeURIComponent(projectId)}/sessions/${encodeURIComponent(runwieldSessionId)}`;
const payload = codeReview
    ? {
        ...codeReview,
        token: `workspace:${operationId}:${interactionId}`,
        mode: "workspace",
        csrfToken: Astro.cookies.get("rw_owner_csrf")?.value || "",
        projectId,
        runwieldSessionId,
        reviewContext: {
            projectLabel: projectId,
            sessionHref,
            sessionLabel: runwieldSessionId,
            actingSession: runwieldSessionId,
            artifactLabel: codeReview.planTitle || codeReview.planName || "Code changes",
            statusLabel: "Human code review",
            live: true,
        },
        interactionAnswerUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/session-operations/${
            encodeURIComponent(operationId)
        }/interactions/${encodeURIComponent(interactionId)}/answer`,
        interactionAnswerBaseUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/session-operations/${
            encodeURIComponent(operationId)
        }/interactions`,
        interactionId,
        operationStatusUrl: `/api/owner/session-operations/${encodeURIComponent(operationId)}`,
    }
    : null;
---
<ReviewLayout
    title="Code Review · RunWield Workspace"
>
    {payload ? (
        <CodeReviewSurface payload={payload} client:only="react">
            <LoadingSurface slot="fallback" label="Loading code review" />
        </CodeReviewSurface>
    ) : (
        <section class="error-panel">
            <h1>Code Review is no longer available</h1>
            <p>This live review ended or belongs to a different Session.</p>
            <a class="secondary-action" href={sessionHref}>Return to Session</a>
        </section>
    )}
</ReviewLayout>
