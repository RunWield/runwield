---
import type { OwnerProjectView } from "../../server/owner-projects.ts";
import SettingsLayout from "../../layouts/SettingsLayout.astro";
import { loadOwnerProjects } from "../../server/astro-owner-data.js";

const projects = await loadOwnerProjects();
---
<SettingsLayout title="Projects · RunWield Workspace" active="projects">
    <section class="workspace-settings-intro">
        <h1>Projects</h1>
        <p>Link a Project or manage an existing one.</p>
    </section>
    <section class="owner-card project-link-card">
        <h2>Link a Project</h2>
        <form class="owner-form project-register-form" data-project-register>
            <label>Project root <input name="root" required placeholder="Absolute path to a Project" /></label>
            <label>Display name <input name="displayName" placeholder="Optional" /></label>
            <button class="primary-action" type="submit">Link Project</button>
        </form>
        <p class="muted" data-project-register-status role="status"></p>
    </section>
    <section class="project-list-panel" aria-label="Linked Projects">
        {projects.length ? projects.map((project: OwnerProjectView) => (
            <a
                class="project-list-row"
                href={`/projects/${encodeURIComponent(project.projectId)}/settings`}
            >
                <span>
                    <strong>{project.displayName}</strong>
                    <small>{project.rootLabel} · {project.healthStatus}</small>
                </span>
                <span class="project-list-state">{project.lifecycle}{project.enabled ? "" : " · unavailable"}</span>
            </a>
        )) : (
            <p class="empty">No Projects are linked yet.</p>
        )}
    </section>
    <script is:inline data-astro-rerun>
        function rwProjectOwnerCookie(name){return document.cookie.split('; ').find(v=>v.startsWith(name+'='))?.split('=').slice(1).join('=')||'';}
        async function rwProjectOwnerFetch(url,options={}){options.headers=Object.assign({'content-type':'application/json','x-runwield-csrf':decodeURIComponent(rwProjectOwnerCookie('rw_owner_csrf'))},options.headers||{});return await fetch(url,options);}
        function rwProjectNavigate(href){const event=new CustomEvent('runwield:workspace-navigate',{cancelable:true,detail:{href,history:'push'}});if(document.dispatchEvent(event))location.assign(href);}
        document.querySelectorAll('[data-project-register]').forEach((registerForm)=>{if(registerForm.dataset.workspaceBound==='true')return;registerForm.dataset.workspaceBound='true';const status=registerForm.closest('.project-link-card')?.querySelector('[data-project-register-status]')||document.querySelector('[data-project-register-status]');registerForm.addEventListener('submit',async(event)=>{event.preventDefault();const formData=new FormData(registerForm);if(status)status.textContent='Linking Project...';const response=await rwProjectOwnerFetch('/api/owner/projects',{method:'POST',body:JSON.stringify({root:formData.get('root'),displayName:formData.get('displayName')})});const data=await response.json().catch(()=>({}));if(response.ok&&data.project?.projectId){rwProjectNavigate('/projects/'+encodeURIComponent(data.project.projectId)+'/settings');return;}if(status)status.textContent=data.error||'Project link failed.';});});
    </script>
</SettingsLayout>
