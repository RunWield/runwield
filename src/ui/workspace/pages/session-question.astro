---
import type { WorkspaceQuestionPayload } from "../server.ts";
import WorkspaceLayout from "../layouts/WorkspaceLayout.astro";
import { SessionQuestionForm } from "../components/SessionQuestionForm.tsx";

const payloadHeader = Astro.request.headers.get("x-runwield-question-payload") || "";
let payload = {};
try {
    payload = payloadHeader ? JSON.parse(decodeURIComponent(payloadHeader)) : {};
} catch {
    payload = {};
}
const data: WorkspaceQuestionPayload = payload;
---
<WorkspaceLayout title="RunWield Question" selectedTab="sessions" shell="local" url={Astro.url.href}>
    <div class="rw-question-fixture">
        <SessionQuestionForm
            client:load
            mode={data.mode || "select"}
            prompt={data.prompt || "RunWield question"}
            value={data.defaultValue || ""}
            placeholder={data.placeholder || ""}
            allowEmpty={data.allowEmpty === true}
            action={data.action || ""}
            sessionId={data.sessionId || ""}
            questionId={data.questionId || ""}
            options={data.options || []}
        />
    </div>
</WorkspaceLayout>
