---
import process from "node:process";
import LoadingSurface from "../../components/LoadingSurface.astro";
import ReviewLayout from "../../layouts/ReviewLayout.astro";
import { RemotePlanReview } from "../../react/RemotePlanReview.tsx";
import { isRemoteDevelopmentModeEnabled } from "../../server/remote-mode.ts";

if (
    import.meta.env.DEV &&
    !isRemoteDevelopmentModeEnabled({
        isDevelopment: import.meta.env.DEV,
        workspaceMode: process.env.RUNWIELD_WORKSPACE_MODE,
    })
) {
    return new Response("Not found", { status: 404 });
}

const spaceId = Astro.params.spaceId ?? "";
---
<ReviewLayout title="Remote Plan Review · RunWield Workspace">
    <RemotePlanReview spaceId={spaceId} client:only="react">
        <div slot="fallback"><LoadingSurface label="Loading Shared Space" /></div>
    </RemotePlanReview>
</ReviewLayout>
