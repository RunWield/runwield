# Build clean first-run / new-user UX images through the checked-in installer.
#
# Targets:
#   wld-ux-latest  - runs the latest published RunWield release installed by ./install.sh
#   wld-ux-current - provisions helpers with ./install.sh, then runs ./bin/wld compiled from this checkout
#   wld-workspace  - persistent owner Workspace (work in progress; not yet documented)
#
# Build latest release:
#   podman build --target wld-ux-latest --build-arg WLD_INSTALL_REFRESH=$(date +%s) -f Containerfile.wld-ux -t runwield-wld-ux:local .
#
# Build current checkout binary:
#   deno task compile --target aarch64-unknown-linux-gnu
#   podman build --target wld-ux-current --build-arg WLD_INSTALL_REFRESH=$(date +%s) -f Containerfile.wld-ux -t runwield-wld-ux-current:local .
#
# Start wld in a fresh disposable project:
#   podman run --rm -it \
#     -e ANTHROPIC_API_KEY \
#     -e OPENAI_API_KEY \
#     runwield-wld-ux:local

FROM denoland/deno:2.9.3 AS wld-ux-base

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gnupg \
        gzip \
        less \
        libsqlite3-0 \
        openssh-client \
        tar \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && node --version \
    && npm --version \
    && rm -rf /var/lib/apt/lists/*

ENV HOME=/home/deno \
    WLD_INSTALL_DIR=/home/deno/.local/bin \
    PATH=/home/deno/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    WLD_NEW_USER_UX_CONTAINER=1 \
    WLD_NONINTERACTIVE=1 \
    NO_COLOR=0

RUN mkdir -p /workspace/project /home/deno/.wld /home/deno/.local/bin \
    && chown -R deno:deno /workspace /home/deno

COPY --chown=deno:deno install.sh /tmp/install.sh

USER deno
WORKDIR /workspace/project

ARG WLD_INSTALL_REFRESH=manual
RUN echo "[wld-ux] install refresh: ${WLD_INSTALL_REFRESH}" \
    && bash /tmp/install.sh

VOLUME ["/workspace/project", "/home/deno/.wld"]

FROM wld-ux-base AS wld-ux-latest

RUN command -v wld mnemoteca cymbal ketch agent-browser snip \
    && wld --version \
    && mnemoteca version \
    && cymbal version \
    && ketch --version \
    && agent-browser --version \
    && snip --version

ENTRYPOINT ["wld"]

FROM wld-ux-base AS wld-ux-current

COPY --chown=deno:deno bin/wld /tmp/wld-current

RUN install -m 755 /tmp/wld-current "$WLD_INSTALL_DIR/wld" \
    && command -v wld mnemoteca cymbal ketch agent-browser snip \
    && wld --version \
    && mnemoteca version \
    && cymbal version \
    && ketch --version \
    && agent-browser --version \
    && snip --version

ENTRYPOINT ["wld"]

# Persistent owner Workspace; compile bin/wld for the image architecture first.
FROM wld-ux-current AS wld-workspace

ENV MNEMOTECA_DB_PATH=/home/deno/.wld/mnemoteca.db
RUN mkdir -p /home/deno/.agents
COPY --chmod=755 packaging/workspace/entrypoint.sh /usr/local/bin/workspace-entrypoint

EXPOSE 8787
VOLUME ["/home/deno/.agents"]
ENTRYPOINT ["/usr/local/bin/workspace-entrypoint"]
CMD []
