{
    "name": "runwield",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.3",
    "engines": {
        "bun": "1.4.3"
    },
    "trustedDependencies": [],
    "scripts": {
        "install:locked": "bun scripts/check-bun-runtime.ts && bun install --frozen-lockfile --ignore-scripts && cd docs-site && bun install --frozen-lockfile --ignore-scripts",
        "fmt": "bun node_modules/prettier/bin/prettier.cjs --tab-width 4 --print-width 120",
        "fmt:check": "bun node_modules/prettier/bin/prettier.cjs --tab-width 4 --print-width 120 --check",
        "check:bun": "bun run check",
        "test:bun": "bun scripts/run-bun-tests.ts",
        "check:portable-json": "bun scripts/check-portable-json.ts",
        "workspace:build:bun": "bun run workspace:build",
        "ci:bun": "bun run ci",
        "compile:bun": "bun run workspace:build && bun run scripts/compile-bun.ts",
        "check:package:bun": "bun run scripts/check-bun-package.ts",
        "check:provider:bun": "bun run scripts/check-bun-provider.ts",
        "lint:bun": "bun run lint",
        "check": "bun scripts/write-version.js && bun scripts/check-bun-types.ts",
        "lint": "bun scripts/run-bun-lint.ts",
        "workspace:check": "bun scripts/check-workspace.ts",
        "workspace:build": "bun scripts/check-bun-runtime.ts && bun scripts/write-version.js && bun node_modules/astro/bin/astro.mjs build --config src/ui/workspace/astro.config.mjs",
        "docs:stage": "bun scripts/public-docs.ts",
        "docs:dev": "bun scripts/docs-dev.ts",
        "docs:build": "bun run docs:stage && cd docs-site && bun node_modules/astro/bin/astro.mjs build",
        "docs:check": "bun run docs:stage && cd docs-site && bun node_modules/astro/bin/astro.mjs check && cd .. && bun run docs:build && bun scripts/check-public-docs.ts",
        "test:suite": "bun scripts/run-tests.js --exclude src/ui/tui/golden-scenarios --exclude src/ui/tui/testing",
        "test:all:suite": "bun scripts/run-tests.js",
        "submodules:check": "bun scripts/check-submodules.js",
        "snip:check": "bun scripts/check-snip-filters.ts",
        "language-policy:check": "bun scripts/check-language-policy.js",
        "seams:check": "bun scripts/check-injection-seams.js",
        "doc-links:check": "bun scripts/check-doc-links.js",
        "skills:sync:check": "bun scripts/check-skill-sync.ts",
        "ci": "bun scripts/check-bun-runtime.ts && bun scripts/run-ci.ts",
        "cli": "bun src/cli.ts",
        "submodules:check:remote": "bun scripts/check-submodule-fetchability.js",
        "skills:sync:update": "bun scripts/check-skill-sync.ts --update",
        "seams:update": "bun scripts/check-injection-seams.js --update",
        "test": "bun scripts/write-version.js && bun run workspace:build && bun run test:suite",
        "test:all": "bun scripts/write-version.js && bun run workspace:build && bun run test:all:suite",
        "pr:check": "bun run ci",
        "githooks:install": "git config core.hooksPath .githooks",
        "githooks:uninstall": "git config --unset core.hooksPath",
        "workspace:dev": "bun node_modules/astro/bin/astro.mjs dev --config src/ui/workspace/astro.config.mjs --host 127.0.0.1 --port 5173 --open /dev",
        "workspace:remote:build": "bun run workspace:build && bun scripts/build-workspace-runtime.js && bun scripts/build-plan-server-runtime.js",
        "workspace:remote": "bun src/ui/workspace/remote-server.ts",
        "workspace:remote:image:check": "bun scripts/assert-plan-server-image.js",
        "workspace:react:check": "bun run workspace:check",
        "workspace:test": "bun scripts/run-tests.js --isolated src/ui/workspace src/cmd/plans/ui.test.ts",
        "ux:new-user": "podman build --target wld-ux-latest --build-arg WLD_INSTALL_REFRESH=$(date +%s) -f Containerfile.wld-ux -t runwield-wld-ux:local . && podman run --rm -it -e ANTHROPIC_API_KEY -e OPENAI_API_KEY -e GOOGLE_API_KEY -e MISTRAL_API_KEY runwield-wld-ux:local",
        "release:check": "bun scripts/release-check.js",
        "release:metadata": "bun scripts/release.js metadata",
        "release:candidate": "bun scripts/release.js candidate",
        "release:promote": "bun scripts/release.js promote",
        "release:stable": "bun scripts/release.js stable",
        "package:homebrew": "bun scripts/package-homebrew.js",
        "package:homebrew:check": "bun scripts/package-homebrew-check.js",
        "package:windows": "bun scripts/package-windows.js",
        "package:windows:check": "bun scripts/package-windows-check.js",
        "package:winget": "bun scripts/package-winget.js",
        "prototype": "bun scripts/run-prototype.js",
        "test:golden-tui": "bun scripts/write-version.js && bun scripts/run-tests.js --isolated src/ui/tui/testing src/ui/tui/golden-scenarios",
        "test:golden-tui:extensive": "bun scripts/write-version.js && bun scripts/run-tests.js --isolated src/ui/tui/testing src/ui/tui/golden-scenarios",
        "compile": "bun run workspace:build && bun scripts/compile-command.ts",
        "compile:watch": "watchexec -e js,jsx,mjs,md,css,ts,tsx,json --ignore node_modules --ignore dist --ignore bin --ignore src/shared/version.js -- bun run compile",
        "ux:new-user:current": "sh -c 'case $(uname -m) in arm64|aarch64) target=aarch64-unknown-linux-gnu ;; x86_64|amd64) target=x86_64-unknown-linux-gnu ;; *) echo unsupported container compile architecture: $(uname -m) >&2; exit 1 ;; esac; bun run compile --target \"$target\" && podman build --target wld-ux-current --build-arg WLD_INSTALL_REFRESH=$(date +%s) -f Containerfile.wld-ux -t runwield-wld-ux-current:local . && podman run --rm -it -e ANTHROPIC_API_KEY -e OPENAI_API_KEY -e GOOGLE_API_KEY -e MISTRAL_API_KEY runwield-wld-ux-current:local'"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "1.4.0",
        "@astrojs/check": "0.9.10",
        "@astrojs/react": "6.0.1",
        "@base-ui/react": "1.7.0",
        "@codemirror/autocomplete": "6.20.3",
        "@codemirror/commands": "6.11.1",
        "@codemirror/lang-javascript": "6.2.5",
        "@codemirror/lang-json": "6.0.2",
        "@codemirror/lang-markdown": "6.5.2",
        "@codemirror/lang-python": "6.2.1",
        "@codemirror/lang-yaml": "6.1.3",
        "@codemirror/language": "6.12.4",
        "@codemirror/legacy-modes": "6.5.3",
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.14",
        "@earendil-works/pi-agent-core": "1.0.4",
        "@earendil-works/pi-ai": "1.0.4",
        "@earendil-works/pi-coding-agent": "1.0.4",
        "@earendil-works/pi-mcp": "1.0.4",
        "@earendil-works/pi-tui": "1.0.4",
        "@lezer/common": "1.5.2",
        "@lezer/highlight": "1.2.5",
        "@modelcontextprotocol/sdk": "1.30.0",
        "@pierre/diffs": "1.4.2",
        "@plannotator/atomic-editor": "0.8.0",
        "@plannotator/markdown-editor": "0.4.0",
        "@plannotator/web-highlighter": "0.8.1",
        "@preact/signals": "2.11.3",
        "@radix-ui/react-checkbox": "1.3.11",
        "@radix-ui/react-collapsible": "1.1.20",
        "@radix-ui/react-context-menu": "2.3.5",
        "@radix-ui/react-dialog": "1.1.23",
        "@radix-ui/react-dropdown-menu": "2.1.24",
        "@radix-ui/react-popover": "1.1.23",
        "@radix-ui/react-slot": "1.3.3",
        "@radix-ui/react-tabs": "1.1.21",
        "@radix-ui/react-tooltip": "1.2.16",
        "@silvia-odwyer/photon-node": "0.3.4",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-table": "8.21.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.1.0",
        "@viz-js/viz": "3.29.0",
        "@xterm/headless": "6.0.0",
        "@zag-js/dialog": "1.42.0",
        "@zag-js/preact": "1.45.0",
        "astro": "7.3.5",
        "beautiful-mermaid": "1.1.3",
        "chalk": "6.0.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "codemirror": "6.0.2",
        "diff": "9.0.0",
        "dockview-react": "8.4.0",
        "dompurify": "3.4.15",
        "esbuild": "0.28.2",
        "fuse.js": "7.5.0",
        "happy-dom": "20.14.5",
        "highlight.js": "11.11.1",
        "js-yaml": "4.3.2",
        "jsonc-parser": "3.3.1",
        "katex": "0.18.5",
        "lucide-react": "1.45.0",
        "marked": "18.0.11",
        "mermaid": "12.0.0",
        "motion": "13.2.0",
        "perfect-freehand": "1.2.3",
        "preact": "11.0.1",
        "proper-lockfile": "4.1.2",
        "quikdown": "1.2.21",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-test-renderer": "19.2.7",
        "strip-ansi": "7.2.0",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "unique-username-generator": "1.5.1",
        "vite": "8.3.2",
        "yargs-parser": "22.0.0"
    },
    "devDependencies": {
        "@sinonjs/fake-timers": "15.4.0",
        "@types/bun": "1.3.12",
        "@types/js-yaml": "4.0.9",
        "@types/node": "26.6.4",
        "@types/proper-lockfile": "4.1.4",
        "@types/react-test-renderer": "19.3.0",
        "@types/sinonjs__fake-timers": "15.0.1",
        "@types/yargs-parser": "21.0.3",
        "@typescript-eslint/utils": "8.71.1",
        "eslint": "9.39.5",
        "eslint-plugin-react": "7.37.5",
        "prettier": "3.9.9",
        "typescript-eslint": "8.71.1"
    },
    "overrides": {
        "@earendil-works/chord": "1.0.4",
        "@earendil-works/pi-codemode": "1.0.4",
        "@earendil-works/pi-telemetry": "1.0.4",
        "@earendil-works/pi-agent-core": "1.0.4",
        "@earendil-works/pi-ai": "1.0.4",
        "@earendil-works/pi-coding-agent": "1.0.4",
        "@earendil-works/pi-mcp": "1.0.4",
        "@earendil-works/pi-tui": "1.0.4"
    }
}
